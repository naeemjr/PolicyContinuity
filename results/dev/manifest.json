{
  "adapters": [
    {
      "contract_version": 2,
      "fallback_rule": "not-applicable",
      "name": "lexical-prefix",
      "strategy": "normalise the joined path as text, check it is beneath the root, open it by path"
    },
    {
      "contract_version": 2,
      "fallback_rule": "legacy-when-enabled",
      "name": "canonicalize-then-open",
      "strategy": "realpath the joined path, check it is beneath the root, open the resolved path"
    },
    {
      "contract_version": 1,
      "fallback_rule": "legacy-when-enabled",
      "name": "dirfd-relative",
      "strategy": "openat each component from the root handle with O_NOFOLLOW; never follow a symlink"
    },
    {
      "contract_version": 1,
      "fallback_rule": "never",
      "name": "strict-safe-open",
      "strategy": "openat2(RESOLVE_BENEATH) from the root handle; report unsupported if unavailable"
    }
  ],
  "auxiliary_twin_runs": 640,
  "bootstrap_resamples": 10000,
  "depth_held_out": [
    5,
    6
  ],
  "depth_in_distribution": [
    1,
    4
  ],
  "evaluated_runs": 7680,
  "families": [
    "nested-in-root",
    "dotdot-normalization",
    "symlink-in-root-target",
    "symlink-outside-target",
    "symlink-swap",
    "parent-dir-rename",
    "file-replacement",
    "retry-after-failure",
